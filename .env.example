# --- Configuración de entorno para PEI Compromiso 360° ---

# Modo de persistencia del repositorio de compromisos
# 'local' = LocalStorage (desarrollo, sin backend)
# 'remote' = Cloudflare Workers + D1 (producción)
VITE_REPOSITORY_MODE=remote

# URL base de la API del Worker (misma origen en producción, vacía = relativo)
VITE_API_BASE_URL=

# URL pública del compromiso para el QR (debe terminar en /compromiso)
# Producción: https://pei-compromiso-worker.gpt5plus123.workers.dev/compromiso
# Desarrollo (LAN): http://192.168.x.x:3000/compromiso  (IP de tu equipo en la red local)
# NO usar localhost ni 127.0.0.1 para celulares externos.
VITE_PUBLIC_COMMITMENT_URL=

# --- Variables solo para el Worker (no expuestas al frontend) ---

# Hash PBKDF2 de la contraseña de administrador (generar de forma segura)
# ADMIN_PASSWORD_HASH=

# Salt PBKDF2 para la contraseña de administrador
# ADMIN_PASSWORD_SALT=

# Secreto para firma de sesiones (opcional, se deriva del hash)
# SESSION_SECRET=
